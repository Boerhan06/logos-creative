# ═══════════════════════════════════════════════════════════════
# Logos Creative — Hostinger Apache / LiteSpeed Configuration
# ═══════════════════════════════════════════════════════════════

# 1. Pastikan HTML tidak di-cache browser/CDN agar selalu memuat CSS/JS terbaru
<FilesMatch "\.(html|htm)$">
  FileETag None
  <IfModule mod_headers.c>
    Header unset ETag
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </IfModule>
</FilesMatch>

# 2. Cache lama untuk file statis Next.js yang memiliki hash unik
<FilesMatch "\.(css|js|woff2|woff|webp|png|jpg|jpeg|svg|mp4)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# 3. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
