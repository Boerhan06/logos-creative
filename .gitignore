# ==============================================================================
# Git Ignore - Logos Creative (Security & Environment Best Practices)
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Sensitive credentials & keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519
secrets/
credentials.json
deploy-config.json
.deploy-manifest.json
*.passwd

# Next.js Build Outputs & Caches
/.next/
/out/
/build
/dist

# Testing & Coverage
/coverage
*.lcov
.nyc_output

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories (Optional developer-specific)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# TypeScript & Next build info
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
